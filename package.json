{
  "name": "ticket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/to-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:chart": "vite build && node scripts/check-chart.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:draw": "vite build && node scripts/check-draw.mjs",
    "check:easy": "vite build && node scripts/check-easy.mjs"
  },
  "dependencies": {
    "@derivexyz/derive-ts": "^3.0.29",
    "ethers": "^6.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
